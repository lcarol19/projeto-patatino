# ============================================================
# .env.example — copie para .env e preencha com seus dados
# NUNCA commite o .env no Git
# ============================================================

APP_SECRET_KEY=troque-por-uma-string-secreta-longa

# Banco de dados — Aiven MySQL
DB_HOST=seu-host.aivencloud.com
DB_PORT=21785
DB_USER=avnadmin
DB_PASSWORD=sua-senha-aqui
DB_NAME=patatino_pets
SSL_CA=ca.pem

# Cloudinary — upload de fotos
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
